# Copiar como backend/.env para trabajar en local (no se sube a GitHub).
# En Render estas variables se cargan en el panel del servicio rg-pisos-backend.

NODE_ENV=development
PORT=4000

# Supabase (proyecto NUEVO de RG Pisos) -> Project Settings > Database > Connection string
# Pooler (puerto 6543), con pgbouncer=true:
DATABASE_URL="postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432), la usan las migraciones:
DIRECT_URL="postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Supabase Storage (fotos y logo) -> Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=branding

# Sesiones: texto largo al azar (mínimo 16 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos (URL del frontend), separados por coma
CORS_ORIGIN=http://localhost:5173

# Mail por Google Apps Script (Render gratuito bloquea SMTP)
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
SMTP_FROM="RG Pisos <no-reply@rgpisos.local>"

# Revisión diaria disparada desde cron-job.org (header X-Cron-Secret)
CRON_SECRET=
APP_TIMEZONE=America/Argentina/Buenos_Aires
